[Unit]
Description=Local OpenProject Unix socket proxy
After=docker.service

[Service]
ExecStart=/usr/bin/socat TCP4-LISTEN:8088,bind=127.0.0.1,reuseaddr,fork UNIX-CONNECT:/home/fivek777/.local/share/openproject/socket/puma.sock
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
UMask=0077

[Install]
WantedBy=default.target
